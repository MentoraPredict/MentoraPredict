{
  "name": "@mentorapredict/academic-service",
  "version": "1.0.0",
  "private": true,
  "description": "Academic data: faculties, subjects, enrollments, evaluations, grades — placeholder, no logic implemented",
  "scripts": {
    "build": "pnpm exec nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src/",
    "test": "jest --config jest.config.js --no-coverage",
    "test:cov": "jest --config jest.config.js --coverage",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "backfill:user-references": "ts-node src/scripts/backfill-user-references.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@mentorapredict/shared-logger": "workspace:*",
    "@mentorapredict/shared-types": "workspace:*",
    "dotenv": "^16.4.5",
    "nestjs-pino": "^4.1.0",
    "pino-http": "^10.3.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.3.2",
    "mongoose": "^8.3.0",
    "multer": "^2.0.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.9.2",
    "@types/uuid": "^10.0.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
