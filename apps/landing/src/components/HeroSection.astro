---
interface Props {
  badgeText: string;
  headline: string;
  subtext: string;
  ctaPrimaryText: string;
  ctaPrimaryLink: string;
  ctaSecondaryText: string;
  ctaSecondaryLink: string;
  imageUrl: string;
  imageAlt: string;
}

const {
  badgeText,
  headline,
  subtext,
  ctaPrimaryText,
  ctaPrimaryLink,
  ctaSecondaryText,
  ctaSecondaryLink,
  imageUrl,
  imageAlt,
} = Astro.props;

import { SITE_CONFIG } from "../config/site";

const resolvedPrimaryLink = ctaPrimaryLink.startsWith("http")
  ? ctaPrimaryLink
  : `${SITE_CONFIG.webAppUrl}${ctaPrimaryLink}`;
---

<section
  id="hero"
  class="overflow-hidden scroll-mt-20 bg-gray-50 py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-container px-6 sm:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1fr] lg:gap-16">
      <div class="max-w-xl">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-blue-100/80 px-3 py-1.5 text-[0.68rem] font-extrabold uppercase tracking-[0.08em] text-blue-900"
        >
          <svg class="size-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
            <path d="M5 0L6.12 3.88L10 5L6.12 6.12L5 10L3.88 6.12L0 5L3.88 3.88L5 0Z" />
          </svg>
          {badgeText}
        </span>

        <h1
          class="mt-6 max-w-[12ch] text-4xl font-extrabold leading-[1.08] text-gray-900 sm:text-5xl"
        >
          {headline.split("academic failure.").length > 1
            ? <Fragment>{headline.split("academic failure.")[0]}<span class="text-blue-700">academic failure.</span></Fragment>
            : headline
          }
        </h1>

        <p class="mt-6 max-w-md text-sm leading-6 text-gray-500 sm:text-base">
          {subtext}
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={resolvedPrimaryLink}
            class="inline-flex items-center gap-2 rounded-lg bg-blue-700 px-7 py-3 text-sm font-semibold text-white shadow-[0_18px_30px_rgba(21,101,192,0.22)] transition-all hover:bg-blue-800 hover:shadow-lg"
          >
            {ctaPrimaryText}
            <svg class="size-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M1 7h12M8 2l5 5-5 5" />
            </svg>
          </a>

          <a
            href={ctaSecondaryLink}
            class="inline-flex items-center gap-2 rounded-lg border border-blue-200 bg-white px-7 py-3 text-sm font-semibold text-blue-700 transition-all hover:bg-blue-50 hover:shadow-sm"
          >
            {ctaSecondaryText}
            <svg class="size-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M7 1v10M3 8l4 4 4-4" />
            </svg>
          </a>
        </div>
      </div>

      <div class="relative mx-auto hidden max-w-md lg:block">
        <div class="relative rotate-2 overflow-hidden rounded-2xl border border-blue-100 bg-white p-2 shadow-[0_22px_60px_rgba(15,79,146,0.14)] transition duration-300 hover:rotate-1">
          <img
            src={imageUrl}
            alt={imageAlt}
            class="aspect-[4/3] w-full rounded-xl object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-6 -left-6 -z-10 size-32 rounded-full bg-blue-100/40 blur-2xl"></div>
        <div class="absolute -right-6 -top-6 -z-10 size-40 rounded-full bg-blue-200/30 blur-3xl"></div>
      </div>
    </div>
  </div>
</section>
