---
import { SITE_CONFIG } from "../config/site";

const basePath = import.meta.env.BASE_URL;
---

<section
  id="hero"
  class="overflow-hidden scroll-mt-20 bg-neutral-50 py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-container px-6">
    <div class="grid items-center gap-12 lg:grid-cols-[0.86fr_1.14fr] lg:gap-16">
      <div class="max-w-xl">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-primary-100/80 px-3 py-1.5 text-[0.68rem] font-extrabold uppercase tracking-[0.08em] text-primary-900"
        >
          <svg class="size-2.5" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
            <path d="M5 0L6.12 3.88L10 5L6.12 6.12L5 10L3.88 6.12L0 5L3.88 3.88L5 0Z" />
          </svg>
          New: GPT-4o models integrated
        </span>

        <h1
          class="mt-6 max-w-[12ch] text-4xl font-extrabold leading-[1.08] text-neutral-900 sm:text-5xl"
        >
          Intelligent prediction to prevent
          <span class="text-primary-700">academic failure.</span>
        </h1>

        <p class="mt-6 max-w-md text-sm leading-6 text-neutral-500 sm:text-base">
          We transform your educational data into actionable strategies.
          MentoraPredict uses advanced AI to identify at-risk students
          and optimize academic success.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={`${SITE_CONFIG.webAppUrl}/login`}
            class="inline-flex items-center gap-2 rounded-lg bg-primary-700 px-7 py-3 text-sm font-semibold text-white shadow-[0_18px_30px_rgba(21,101,192,0.22)] transition-all hover:bg-primary-800 hover:shadow-lg"
          >
            Get Started
            <svg class="size-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M1 7h12M8 2l5 5-5 5" />
            </svg>
          </a>

          <a
            href="#downloads"
            class="inline-flex items-center gap-2 rounded-lg border border-primary-200 bg-white px-7 py-3 text-sm font-semibold text-primary-700 transition-all hover:bg-primary-50 hover:shadow-sm"
          >
            Download App
            <svg class="size-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M7 1v10M3 8l4 4 4-4" />
            </svg>
          </a>
        </div>
      </div>

      <div class="relative hidden lg:block">
        <div class="relative overflow-hidden rounded-2xl border border-primary-100 bg-white p-2 shadow-[0_22px_60px_rgba(15,79,146,0.14)]">
          <img
            src={`${basePath}images/landing-analytics-dashboard.png`}
            alt="MentoraPredict analytics dashboard preview"
            class="w-full rounded-xl"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-6 -left-6 -z-10 size-32 rounded-full bg-primary-100/40 blur-2xl"></div>
        <div class="absolute -right-6 -top-6 -z-10 size-40 rounded-full bg-primary-200/30 blur-3xl"></div>
      </div>
    </div>
  </div>
</section>
