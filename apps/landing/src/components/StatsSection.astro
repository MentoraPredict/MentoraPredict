---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section id="stats" class="scroll-mt-20 bg-blue-950 py-20">
  <div class="mx-auto max-w-container px-6">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="rounded-2xl bg-white p-6 text-center shadow-md">
          <p class="text-3xl font-semibold text-blue-700">{stat.value}</p>
          <p class="mt-2 text-base text-gray-600">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
