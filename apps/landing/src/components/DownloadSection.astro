---
interface DownloadOption {
  platformType: string;
  label: string;
  platforms: string[];
  downloadUrl: string;
  available: boolean;
}

interface Props {
  downloads: DownloadOption[];
}

const { downloads } = Astro.props;

const desktop = downloads.find((d) => d.platformType === "desktop") ?? {
  platformType: "desktop",
  label: "Download for Desktop",
  platforms: ["Windows", "macOS", "Linux"],
  downloadUrl: "#",
  available: false,
};

const mobile = downloads.find((d) => d.platformType === "mobile") ?? {
  platformType: "mobile",
  label: "Download for Mobile",
  platforms: ["Android", "iOS"],
  downloadUrl: "#",
  available: false,
};
---

<section id="downloads" class="scroll-mt-20 py-20 bg-neutral-50">
  <div class="mx-auto max-w-container px-6">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-neutral-900 sm:text-4xl">
        Download MentoraPredict
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-neutral-500">
        Access MentoraPredict from any device. Available for desktop and mobile platforms.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-2xl gap-6 sm:grid-cols-2">
      <div
        id="desktop-download-card"
        class:list={[
          "group relative rounded-xl border p-8 text-center transition-all",
          desktop.available
            ? "border-primary-200 bg-white shadow-sm hover:border-primary-300 hover:shadow-md"
            : "border-neutral-200 bg-neutral-50 opacity-75",
        ]}
      >
        <span
          id="desktop-badge"
          class:list={[
            "absolute right-4 top-4 rounded-full bg-neutral-200 px-3 py-1 text-xs font-semibold text-neutral-600",
            desktop.available ? "hidden" : "",
          ]}
        >
          Coming Soon
        </span>
        <div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-xl bg-primary-50 text-primary-700">
          <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <path d="M8 21h8M12 17v4" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-neutral-900">{desktop.label}</h3>
        <p class="mt-2 text-sm text-neutral-500">
          {desktop.platforms.join(" / ")}
        </p>
        <a
          id="desktop-download-link"
          href={desktop.available ? desktop.downloadUrl : "#"}
          class:list={[
            "mt-6 inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold transition-all",
            desktop.available
              ? "bg-primary-700 text-white shadow-[0_18px_30px_rgba(21,101,192,0.22)] hover:bg-primary-800 hover:shadow-lg"
              : "cursor-not-allowed border border-neutral-300 bg-neutral-100 text-neutral-400",
          ]}
          aria-disabled={!desktop.available}
          tabindex={desktop.available ? 0 : -1}
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M8 1v10M4 7l4 4 4-4M2 13h12" />
          </svg>
          <span id="desktop-download-text">{desktop.available ? "Download Now" : "Coming Soon"}</span>
        </a>
      </div>

      <div
        id="mobile-download-card"
        class:list={[
          "group relative rounded-xl border p-8 text-center transition-all",
          mobile.available
            ? "border-primary-200 bg-white shadow-sm hover:border-primary-300 hover:shadow-md"
            : "border-neutral-200 bg-neutral-50 opacity-75",
        ]}
      >
        <span
          id="mobile-badge"
          class:list={[
            "absolute right-4 top-4 rounded-full bg-neutral-200 px-3 py-1 text-xs font-semibold text-neutral-600",
            mobile.available ? "hidden" : "",
          ]}
        >
          Coming Soon
        </span>
        <div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-xl bg-primary-50 text-primary-700">
          <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="5" y="2" width="14" height="20" rx="3" />
            <path d="M12 18h.01" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-neutral-900">{mobile.label}</h3>
        <p class="mt-2 text-sm text-neutral-500">
          {mobile.platforms.join(" / ")}
        </p>
        <a
          id="mobile-download-link"
          href={mobile.available ? mobile.downloadUrl : "#"}
          class:list={[
            "mt-6 inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold transition-all",
            mobile.available
              ? "bg-primary-700 text-white shadow-[0_18px_30px_rgba(21,101,192,0.22)] hover:bg-primary-800 hover:shadow-lg"
              : "cursor-not-allowed border border-neutral-300 bg-neutral-100 text-neutral-400",
          ]}
          aria-disabled={!mobile.available}
          tabindex={mobile.available ? 0 : -1}
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M8 1v10M4 7l4 4 4-4M2 13h12" />
          </svg>
          <span id="mobile-download-text">{mobile.available ? "Download Now" : "Coming Soon"}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  interface DownloadManifest {
    downloadUrl?: string;
  }

  function applyManifest(prefix: "desktop" | "mobile", manifest: DownloadManifest) {
    if (!manifest.downloadUrl) return;

    const card = document.getElementById(`${prefix}-download-card`);
    const badge = document.getElementById(`${prefix}-badge`);
    const link = document.getElementById(`${prefix}-download-link`) as HTMLAnchorElement | null;
    const linkText = document.getElementById(`${prefix}-download-text`);

    card?.classList.remove("border-neutral-200", "bg-neutral-50", "opacity-75");
    card?.classList.add("border-primary-200", "bg-white", "shadow-sm", "hover:border-primary-300", "hover:shadow-md");

    badge?.classList.add("hidden");

    if (link) {
      link.href = manifest.downloadUrl;
      link.removeAttribute("aria-disabled");
      link.tabIndex = 0;
      link.classList.remove("cursor-not-allowed", "border", "border-neutral-300", "bg-neutral-100", "text-neutral-400");
      link.classList.add("bg-primary-700", "text-white", "shadow-[0_18px_30px_rgba(21,101,192,0.22)]", "hover:bg-primary-800", "hover:shadow-lg");
    }

    if (linkText) {
      linkText.textContent = "Download Now";
    }
  }

  async function loadManifest(prefix: "desktop" | "mobile") {
    try {
      const response = await fetch(`/downloads/${prefix}.json`, {
        cache: "no-store",
      });
      if (!response.ok) return;
      applyManifest(prefix, (await response.json()) as DownloadManifest);
    } catch {
      // Keep the "Coming Soon" server-rendered state on any failure.
    }
  }

  void loadManifest("desktop");
  void loadManifest("mobile");
</script>
