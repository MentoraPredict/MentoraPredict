---
interface PlatformCopy {
  prefix: "desktop" | "mobile";
  badgeLabel: string;
  title: string;
  description: string;
  downloadLabel: string;
}

const platforms: PlatformCopy[] = [
  {
    prefix: "desktop",
    badgeLabel: "Aplicacion de Escritorio",
    title: "Instala MentoraPredict en tu equipo.",
    description:
      "Descarga el instalador para Windows generado desde el pipeline. El enlace se puede publicar manualmente cuando el instalador este listo.",
    downloadLabel: "Descargar para Windows",
  },
  {
    prefix: "mobile",
    badgeLabel: "Aplicacion Android",
    title: "Prueba MentoraPredict desde el APK interno.",
    description:
      "Descarga la version Android generada desde el pipeline. El enlace se puede publicar manualmente cuando el APK este listo.",
    downloadLabel: "Descargar APK",
  },
];
---

<section id="downloads" class="scroll-mt-20 bg-gray-50 py-20">
  <div class="mx-auto max-w-container px-6">
    <h2 class="sr-only">Descargas de MentoraPredict</h2>

    <div class="grid gap-6 lg:grid-cols-2">
      {
        platforms.map((platform) => (
          <div class="grid items-center gap-8 rounded-2xl border border-blue-100 bg-blue-50/60 p-6 shadow-sm md:grid-cols-[1.15fr_0.85fr] md:p-8">
            <div>
              <span class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-blue-800">
                {platform.prefix === "desktop" ? (
                  <svg
                    class="size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <rect x="2" y="3" width="20" height="14" rx="2" />
                    <path d="M8 21h8M12 17v4" />
                  </svg>
                ) : (
                  <svg
                    class="size-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <rect x="5" y="2" width="14" height="20" rx="3" />
                    <path d="M12 18h.01" />
                  </svg>
                )}
                {platform.badgeLabel}
              </span>

              <h3 class="mt-4 text-2xl font-extrabold leading-tight text-gray-900 sm:text-3xl">
                {platform.title}
              </h3>

              <p class="mt-3 max-w-2xl text-sm leading-6 text-gray-500 sm:text-base">
                {platform.description}
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <a
                  id={`${platform.prefix}-download-link`}
                  href="#"
                  aria-disabled="true"
                  tabindex={-1}
                  class="inline-flex cursor-not-allowed items-center gap-2 rounded-lg bg-blue-700 px-6 py-3 text-sm font-semibold text-white shadow-[0_18px_30px_rgba(21,101,192,0.22)] transition-all hover:bg-blue-800 hover:shadow-lg"
                >
                  <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M8 1v10M4 7l4 4 4-4M2 13h12" />
                  </svg>
                  {platform.downloadLabel}
                </a>

                <a
                  id={`${platform.prefix}-build-link`}
                  href="#"
                  target="_blank"
                  rel="noopener"
                  class="hidden items-center gap-2 rounded-lg border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-gray-700 transition-all hover:bg-gray-50"
                >
                  Ver build
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <path d="M15 3h6v6M10 14 21 3" />
                  </svg>
                </a>
              </div>
            </div>

            <div class="rounded-xl border border-white bg-white/85 p-5">
              <dl class="space-y-4 text-sm">
                <div>
                  <dt class="font-semibold text-gray-500">Estado</dt>
                  <dd id={`${platform.prefix}-status`} class="mt-1 font-bold text-gray-900">
                    Esperando primer build
                  </dd>
                </div>

                <div>
                  <dt class="font-semibold text-gray-500">Ambiente</dt>
                  <dd id={`${platform.prefix}-environment`} class="mt-1 font-bold text-gray-900">
                    Proximamente
                  </dd>
                </div>

                <div>
                  <dt class="font-semibold text-gray-500">Ultima actualizacion</dt>
                  <dd id={`${platform.prefix}-updated-at`} class="mt-1 font-bold text-gray-900">
                    Pendiente de publicacion
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  interface DownloadManifest {
    environment?: string;
    downloadUrl?: string;
    buildUrl?: string;
    updatedAt?: string;
  }

  function formatUpdatedAt(value?: string) {
    if (!value) {
      return "Pendiente de publicacion";
    }

    const parsedDate = new Date(value);

    if (Number.isNaN(parsedDate.getTime())) {
      return "Fecha no disponible";
    }

    return new Intl.DateTimeFormat("es-EC", {
      dateStyle: "medium",
      timeStyle: "short",
    }).format(parsedDate);
  }

  function applyManifest(prefix: "desktop" | "mobile", manifest: DownloadManifest) {
    const hasDownload = Boolean(manifest.downloadUrl);

    const link = document.getElementById(`${prefix}-download-link`) as HTMLAnchorElement | null;
    const buildLink = document.getElementById(`${prefix}-build-link`) as HTMLAnchorElement | null;
    const status = document.getElementById(`${prefix}-status`);
    const environment = document.getElementById(`${prefix}-environment`);
    const updatedAt = document.getElementById(`${prefix}-updated-at`);

    if (status) {
      status.textContent = hasDownload ? "Disponible" : "Esperando primer build";
    }

    if (environment) {
      const env = manifest.environment?.toUpperCase();
      environment.textContent = env && env !== "LOCAL" ? env : "Proximamente";
    }

    if (updatedAt) {
      updatedAt.textContent = formatUpdatedAt(manifest.updatedAt);
    }

    if (hasDownload && link && manifest.downloadUrl) {
      link.href = manifest.downloadUrl;
      link.removeAttribute("aria-disabled");
      link.tabIndex = 0;
      link.classList.remove("cursor-not-allowed");
    }

    if (manifest.buildUrl && buildLink) {
      buildLink.href = manifest.buildUrl;
      buildLink.classList.remove("hidden");
      buildLink.classList.add("inline-flex");
    }
  }

  async function loadManifest(prefix: "desktop" | "mobile") {
    try {
      const response = await fetch(`/downloads/${prefix}.json`, {
        cache: "no-store",
      });
      if (!response.ok) return;
      applyManifest(prefix, (await response.json()) as DownloadManifest);
    } catch {
      // Keep the "Esperando primer build" server-rendered state on any failure.
    }
  }

  void loadManifest("desktop");
  void loadManifest("mobile");
</script>
