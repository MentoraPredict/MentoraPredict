---
interface Feature {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
---

<section id="features" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-container px-6">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Features</h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-500">
        Our technology combines machine learning with modern pedagogy to offer a 360-degree
        view of the student ecosystem.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {features.map((feature) => (
        <div class="group rounded-xl border border-gray-200 bg-white p-8 text-center shadow-sm transition-all hover:border-blue-200 hover:shadow-md">
          <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-lg bg-blue-50 text-blue-700 transition-colors group-hover:bg-blue-100">
            {feature.icon === "brain" && (
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 2a7 7 0 0 0-7 7c0 2.5 1.5 4.5 3 6v2a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2c1.5-1.5 3-3.5 3-6a7 7 0 0 0-7-7z" />
                <path d="M9 22h6M10 17v3M14 17v3" />
              </svg>
            )}
            {feature.icon === "bell" && (
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
              </svg>
            )}
            {feature.icon === "chart" && (
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
              </svg>
            )}
          </div>
          <h3 class="text-xl font-bold text-gray-900">{feature.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-gray-500">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
