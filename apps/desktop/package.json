{
  "name": "@mentorapredict/desktop",
  "version": "1.0.0",
  "description": "Aplicacion desktop de MentoraPredict",
  "author": "Equipo MentoraPredict - Universidad Central del Ecuador",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @mentorapredict/web dev\" \"tsc --watch --preserveWatchOutput\" \"wait-on http://localhost:5173 dist/main.js && electron .\"",
    "build": "tsc",
    "package": "pnpm --filter @mentorapredict/web build:desktop && pnpm build && electron-builder",
    "package:local": "pnpm --filter @mentorapredict/web build:desktop:local && pnpm build && electron-builder",
    "package:qa": "pnpm --filter @mentorapredict/web build:desktop:qa && pnpm build && electron-builder",
    "package:prod": "pnpm --filter @mentorapredict/web build:desktop:prod && pnpm build && electron-builder",
    "clean": "rimraf dist release"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "concurrently": "^9.0.0",
    "electron": "37.10.3",
    "electron-builder": "^26.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.mentorapredict.desktop",
    "productName": "MentoraPredict",
    "copyright": "Copyright (c) 2026 Equipo MentoraPredict",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/mentorapredict-logo.ico",
      "executableName": "MentoraPredict"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MentoraPredict",
      "installerIcon": "build/mentorapredict-logo.ico",
      "uninstallerIcon": "build/mentorapredict-logo.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}_Setup_${version}_${arch}.${ext}"
    }
  }
}
